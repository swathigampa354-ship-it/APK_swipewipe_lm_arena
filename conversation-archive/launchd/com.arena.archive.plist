<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.arena.archive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>@ARCHIVE_DIR@/bin/watch.sh</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO_ROOT@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@ARCHIVE_DIR@/state/launchd.out</string>
  <key>StandardErrorPath</key><string>@ARCHIVE_DIR@/state/launchd.err</string>
</dict>
</plist>
